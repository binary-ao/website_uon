APP_NAME="Universidade Onze de Novembro"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# URL público exacto (sem barra final). Em XAMPP sem VirtualHost:
# APP_URL=http://localhost/uon_edu/public
APP_URL=http://localhost
APP_TIMEZONE=Africa/Luanda

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base de dados MySQL / MariaDB (utf8mb4, InnoDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uon_website
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Sessões: guardadas na base de dados; expiram após 120 min de inactividade.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Em produção com HTTPS: true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Email (recuperação de palavra-passe e notificações do formulário de contacto).
# Com MAIL_MAILER=log os emails são apenas escritos em storage/logs.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Limites de upload (KB). Confirmar também upload_max_filesize/post_max_size no php.ini.
UON_UPLOAD_MAX_IMAGE_KB=8192
UON_UPLOAD_MAX_DOCUMENT_KB=20480
UON_IMAGE_MAX_WIDTH=1920

# Primeiro superadministrador (opcional; alternativa: php artisan uon:create-admin).
# Usado apenas por `php artisan db:seed`. Apagar a palavra-passe do .env após a instalação.
UON_ADMIN_NAME=
UON_ADMIN_EMAIL=
UON_ADMIN_PASSWORD=
